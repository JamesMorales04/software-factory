# Local runtime artifacts (never commit DBs, tokens, or build outputs).
# Binary ignores are root-anchored: an unanchored `factory-core` pattern
# would also match the `core/cmd/factory-core` SOURCE directory.
/data/
*.db
*.db-wal
*.db-shm
/factory-core
/core/factory-core
dist/
/build/
/target/
__pycache__/
*.pyc
# Agent browser sessions/evidence are runtime artifacts.
/.playwright-cli/
/office/e2e-browser/.playwright-cli/
/office/e2e-browser/.s4a-evidence/
/tmp/
# Accidental simulator state at the repository root.
/.lock
/state.json
/core/.playwright-cli/

office/node_modules/
office/e2e-browser/node_modules

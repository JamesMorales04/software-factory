    "@radix-ui/react-tooltip": "1.4.1",
    "fflate": "^0.8.2",
    "lucide-react": "1.62.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "9.39.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/qrcode": "1.5.5",

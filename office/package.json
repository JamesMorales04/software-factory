    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "knip": "6.45.1",
    "msw": "3.0.5",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-factory.local/schemas/certification-manifest-v1.json",
  "title": "Software Factory certification manifest",
  "type": "object",
  "required": ["schema_version", "certification_id", "level", "status", "implementation_sha", "project_id", "campaign_id", "action_id", "spec_id", "run_id", "attempt_id", "candidate_id", "candidate_sha", "provider", "model", "mode", "session_id", "workspace_id", "browser", "verifier", "reviewer", "quality_gate", "cleanup", "source_evidence", "external_observation_assurance"],
  "properties": {
    "schema_version": {"const": 1},
    "certification_id": {"type": "string", "minLength": 1},
    "level": {"enum": ["DETERMINISTIC_VERIFIED", "REAL_PASEO_E2E_VERIFIED", "PRODUCT_OWNER_UAT_VERIFIED"]},
    "status": {"enum": ["verified", "failed", "blocked", "not_tested", "invalidated"]},
    "implementation_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "project_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "spec_id": {"type": "string", "minLength": 1},
    "spec_binding_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "browser": {"type": "object", "required": ["successful_commands", "managed_test_server"], "properties": {"successful_commands": {"type": "array", "items": {"type": "string"}, "minItems": 2}, "managed_test_server": {"type": "boolean"}}, "additionalProperties": true},
    "verifier": {"type": "object", "required": ["id", "independent", "status"], "properties": {"id": {"type": "string"}, "independent": {"type": "boolean"}, "status": {"type": "string"}}, "additionalProperties": true},
    "reviewer": {"type": "object", "required": ["id", "verdict"], "properties": {"id": {"type": "string"}, "verdict": {"type": "string"}}, "additionalProperties": true},
    "quality_gate": {"type": "object", "required": ["id", "status"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}}, "additionalProperties": true},
    "cleanup": {"type": "object", "required": ["status", "contradictions"], "properties": {"status": {"enum": ["confirmed", "incomplete", "unknown"]}, "contradictions": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "source_evidence": {"type": "string", "minLength": 1},
    "external_observation_assurance": {"const": "repository_recorded_not_independently_corroborated"},
    "invalidated_by": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}

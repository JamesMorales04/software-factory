{
  "optionId": "python-service",
  "language": "python",
  "framework": "fastapi",
  "rationale": "Selects python-service because the objective is a small deterministic Compose service and the project authorizes its required capability.",
  "environmentProposal": {
    "toolchains": [
      {
        "id": "python3",
        "version": "3.12"
      }
    ],
    "packages": [
      {
        "name": "fastapi",
        "version": "0.115.12",
        "license": "MIT",
        "attr": "python312Packages.fastapi",
        "source": "nixpkgs:python312Packages.fastapi"
      }
    ],
    "commands": {
      "build": {
        "argv": [
          "python3",
          "-m",
          "compileall",
          "-q",
          "src"
        ]
      },
      "test": {
        "argv": [
          "python3",
          "-m",
          "pytest",
          "-q"
        ]
      },
      "lint": {
        "argv": [
          "python3",
          "-m",
          "ruff",
          "check",
          "src"
        ]
      },
      "format": {
        "argv": [
          "python3",
          "-m",
          "ruff",
          "format",
          "--check",
          "src"
        ]
      },
      "typecheck": {
        "argv": [
          "python3",
          "-m",
          "mypy",
          "src"
        ]
      },
      "run": {
        "argv": [
          "python3",
          "-m",
          "src"
        ]
      }
    }
  }
}

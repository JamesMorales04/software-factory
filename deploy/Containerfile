# Software Factory developer-preview images.
#
# One multi-stage build produces every runtime image from the same pinned Rust
# and Node bases. Compose selects a target per service so the workspace
# compilation is shared. No image contains credentials or a host toolchain in
# its runtime stage.

ARG RUST_VERSION=1.90.0
ARG NODE_VERSION=22.23.2

FROM rust:${RUST_VERSION}-bookworm AS workspace

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY factory-cli/Cargo.toml factory-cli/Cargo.toml
COPY factory-cli/src factory-cli/src
COPY native/Cargo.toml native/Cargo.toml
COPY native/src native/src
COPY native/fixtures native/fixtures
COPY xtask/Cargo.toml xtask/Cargo.toml
COPY xtask/src xtask/src
COPY migrations migrations
RUN cargo build --locked --release -p factory-native \
      --bin factory-core \
      --bin factory-compose-init \
      --bin factory-supervisor \
      --bin factory-worker \
      --bin factory-verifier \
      --bin factory-reviewer \
      --bin factory-runtime-broker \
      --bin factory-egress-bridge \
      --bin factory-provider-bridge \
      --bin factory-fixture-provider

FROM node:${NODE_VERSION}-bookworm-slim AS office-builder

WORKDIR /office
COPY office/package.json office/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY office/ ./
RUN npm run build

FROM debian:bookworm-slim AS core

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 factory \
    && useradd --uid 10001 --gid factory --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin factory \
    && install -d -o factory -g factory -m 0700 /data /projects

COPY --from=workspace /build/target/release/factory-core /usr/local/bin/factory-core
COPY --from=workspace /build/target/release/factory-compose-init /usr/local/bin/factory-compose-init
COPY --from=office-builder /office/dist /app/office

ENV FACTORY_DATABASE=/data/factory.sqlite \
    FACTORY_OFFICE_DIR=/app/office
EXPOSE 8765
VOLUME ["/data"]
STOPSIGNAL SIGTERM
USER factory

FROM debian:bookworm-slim AS supervisor

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 factory \
    && useradd --uid 10001 --gid factory --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin factory \
    && install -d -o factory -g factory -m 0700 /state /workspaces /projects

COPY --from=workspace /build/target/release/factory-supervisor /usr/local/bin/factory-supervisor
USER 10001:10001
STOPSIGNAL SIGTERM

FROM debian:bookworm-slim AS worker

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git bash util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 factory \
    && useradd --uid 10001 --gid factory --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin factory \
    && install -d -o factory -g factory -m 0700 /provider-sessions /tmp /projects

COPY --from=workspace /build/target/release/factory-worker /usr/local/bin/factory-worker
COPY --from=workspace /build/target/release/factory-provider-bridge /usr/local/bin/factory-provider-bridge
COPY --from=workspace /build/target/release/factory-egress-bridge /usr/local/bin/factory-egress-bridge
USER 10001:10001
STOPSIGNAL SIGTERM

FROM debian:bookworm-slim AS verifier

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 factory \
    && useradd --uid 10001 --gid factory --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin factory \
    && install -d -o factory -g factory -m 0700 /state /verifier /reviewer /projects

COPY --from=workspace /build/target/release/factory-verifier /usr/local/bin/factory-verifier
COPY --from=workspace /build/target/release/factory-reviewer /usr/local/bin/factory-reviewer
USER 10001:10001
STOPSIGNAL SIGTERM

FROM quay.io/podman/stable:v5.8.9 AS runtime

USER root
COPY --from=workspace /build/target/release/factory-runtime-broker /usr/local/bin/factory-runtime-broker
COPY deploy/runtime-entrypoint.sh /usr/local/bin/factory-runtime-entrypoint
RUN sed -i \
      -e 's/^cgroups="disabled"/cgroups="enabled"/' \
      -e 's/^cgroupns="host"/cgroupns="private"/' \
      -e 's/^netns="host"/# netns host default removed by Software Factory/' \
      /etc/containers/containers.conf \
    && printf '%s\n' \
      '[storage]' \
      'driver = "vfs"' \
      'runroot = "/run/containers/storage"' \
      'graphroot = "/var/lib/containers/storage"' \
      > /etc/containers/storage.conf \
    && mkdir -p /var/lib/containers/storage /run/containers/storage \
    && install -d -o 10001 -g 10001 -m 0700 /provider-sessions \
    && chmod 755 /usr/local/bin/factory-runtime-entrypoint /usr/local/bin/factory-runtime-broker

ENV HOME=/tmp \
    TMPDIR=/tmp \
    PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
ENTRYPOINT ["/usr/local/bin/factory-runtime-entrypoint"]
STOPSIGNAL SIGTERM

FROM node:${NODE_VERSION}-bookworm-slim AS provider

ARG OPENCODE_VERSION=1.18.32
ARG CODEX_VERSION=0.156.1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git bash iproute2 tar \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global --no-audit --no-fund \
        "opencode-ai@${OPENCODE_VERSION}" "@openai/codex@${CODEX_VERSION}" \
    && command -v opencode \
    && groupadd --gid 10001 factory \
    && useradd --uid 10001 --gid factory --create-home --home-dir /home/provider \
        --shell /usr/sbin/nologin factory \
    && install -d -o factory -g factory -m 0700 /session

COPY --from=workspace /build/target/release/factory-egress-bridge /usr/local/bin/factory-egress-bridge
COPY --from=workspace /build/target/release/factory-provider-bridge /usr/local/bin/factory-provider-bridge
COPY --from=workspace /build/target/release/factory-fixture-provider /usr/local/bin/factory-fixture-provider
COPY deploy/provider-entrypoint.sh /usr/local/bin/factory-provider-entrypoint

RUN chmod 755 /usr/local/bin/factory-provider-entrypoint /usr/local/bin/factory-*

ENV HOME=/tmp \
    TMPDIR=/tmp \
    PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /session
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/factory-provider-entrypoint"]
STOPSIGNAL SIGTERM
